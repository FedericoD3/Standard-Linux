# UTILITARIOS BASICOS

# Asegurar que estén actualizadas las fuentes:
  sudo apt update && sudo apt upgrade -y

# TODO JUNTO:
# sudo apt install curl wget zip unzip molly-guard hyperfine duf gdu rsync fd-find ranger mc fzf tree bat tealdeer cpufetch sysbench btop
# sudo apt install procs fastfetch du-dust

# DE UNO EN UNO:

# Basicos:
  sudo apt install curl wget zip unzip

# Confirmador de reseteos y apagados remotos ( https://adrianroselli.com/wp-content/uploads/2024/02/switch-with-molly-guard.jpg ):
  sudo apt install molly-guard

# Cronometrador de procesos:
  sudo apt install hyperfine
  # Uso: hyperfine --runs 1 <comando>
  #      hyperfine --min-runs 5 --max-runs 10 <comando>

# Listador de procesos mas informativo que el tradicional ps:
  sudo apt install procs

# Analizadores de ocupación de disco por directorio, mas informativo que el tradicional du:
  sudo apt install duf
  sudo apt gdu
  sudo apt install du-dust     # El binario a ejecutar es solo dust
  # Si no encuentra este último:
    wget https://github.com/bootandy/dust/releases/download/v1.2.4/du-dust_1.2.4-1_amd64.deb -O du-dust.deb
    sudo apt install ./du-dust.deb
    rm ./du-dust.deb

# Sincronizador de archivos (para respaldos scripteables)
  sudo apt install rsync

# Listador de archivos por nombre, mas sencillo / menos versátil que find:
  sudo apt install fd-find

# Navegadores de archivos:
  sudo apt install ranger
  sudo apt install mc

# fzf (FuZzy files, buscador de archivos)
  sudo apt install -y fzf

# Generador de arbol de directorios:
  sudo apt install tree

# Impresor de contenido de archivos mas informativo que el tradicional cat (el ejecutable se llama batcat):
  sudo apt install bat

# tldr (resumidor de manuales de comandos)
  sudo apt install tealdeer

# FORMATEADORES DE INFORMACION DEL EQUIPO:
# Informacion general:
  sudo apt install fastfetch
  # Si no está en los repositorios:
    wget https://github.com/fastfetch-cli/fastfetch/releases/download/2.63.1/fastfetch-linux-amd64.deb -O fastfetch.deb
    sudo apt install ./fastfetch.deb
    rm ./fastfetch.deb
# Información del CPU:
  sudo apt install cpufetch
# Rendimiento del CPU
  sudo apt install sysbench
# Informacion en vivo:
  sudo apt install btop

# RIP (borrador de archivos con cementerio resucitable)
  wget https://github.com/MilesCranmer/rip2/releases/download/v0.9.6/rip-Linux-x86_64-musl.tar.gz -O rip.tar.gz
  tar -xf ./rip.tar.gz
  sudo mv ~/rip /usr/bin
  rm ./rip.tar.gz
  alias rm=rip

# Monitor de eventos de dispositivos de entrada:
  sudo apt install evtest

# procs (listador de procesos mejor formateado que el nativo ps)
  wget https://github.com/dalance/procs/releases/download/v0.14.11/procs-v0.14.11-x86_64-linux.zip -O procs.zip
  unzip ./procs.zip
  sudo mv ~/procs /usr/bin
  rm ./procs.zip
  alias ps=procs

# Manejador de paquetes mas informativo que el tradicional apt: 
  curl https://gitlab.com/volian/volian-archive/-/raw/main/install-nala.sh | bash
# de aquí en adelante se puede usar "sudo apt ..." o "sudo nala ..." 
