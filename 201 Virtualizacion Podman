# Asegurarse que estén actualizados repositorios y paquetes:
  sudo apt-get update 
  sudo apt upgrade

# https://docs.portainer.io/start/install-ce/server/podman/linux

# Instalar podman y verificarlo:
  sudo apt install podman crun podman-compose
  podman --version
# Activar el socket de comunicacion interna:
  # Para root:
    sudo systemctl enable --now podman.socket  
    sudo systemctl    status    podman.socket
  # O para el usuario (más seguro, más limitado):
    systemctl --user enable --now podman.socket
    sudo loginctl enable-linger $USER                 # Para que el proceso permanezca sin que el usuario tenga sesión abierta

# Activar el auto-arranque de podman:
  # https://linuxhandbook.com/courses/podman/autostart-podman-containers/
  sudo systemctl enable --now podman-restart.service
  sudo systemctl    status    podman-restart.service

# Agregar los registries de imagenes para containers:
  sudo nano /etc/containers/registries.conf
    [registries.search]
    registries = ['quay.io', 'docker.io', 'ghcr.io']
  # Ctrl s Ctrl x
# Verificar que lee los registries buscando alguna imagen común:
  podman search portainer

## NOTA: PODMAN NO INICIA LOS CONTAINERS AUTOMATICAMENTE COMO DOCKER SINO DESDE SYSTEMD
#  Se puede generar el service con 
   podman generate systemd --new --name NOMBRE_DEL_CONTAINER
#  pero es muy complejo cubriendo todas las opciones, mejor escribir el .service manualmente:
  nano .config/systemd/user/NOMBRE_DEL_CONTAINER.service
  # con este contenido mínimo:
    [Unit]
     Description=NOMBRE_DEL_CONTAINER
     After=network.target
    [Service]
     ExecStart=podman start NOMBRE_DEL_CONTAINER 
     Restart=always
     User=NOMBRE_DEL_USUARIO  # Verlo con echo $USER
     Group=GRUPO_DEL_USUARIO  # El primero en id -G -n 
    [Install]
     WantedBy=multi-user.target
  # Salvarlo y activarlo como usuario:
      systemctl --user daemon-reload
      systemctl --user enable --now NOMBRE_DEL_CONTAINER.service

# Para entrar en el shell de un container:
  podman exec -it NombreDelContainer> /bin/bash

# Administradores web:
  # PORTAINER
  # https://blog.while-true-do.io/podman-portainer/
    # Sólo la primera vez para que los datos sean persistentes
      podman volume create portainer_data 
    # (re) instanciar el container con la imagen mas reciente:
      # Como usuario (limitado, mas seguro):
             podman run --detach -p 9444:9443 --name 10-portainer --restart=always --security-opt label=disable  --volume /run/user/$(id -u)/podman/podman.sock:/var/run/docker.sock:Z --volume portainer_data:/data:Z docker.io/portainer/portainer-ce
      # Como root:
        sudo podman run --detach -p 9443:9443 --name 10-portainer --restart=always --privileged                  --volume /run/podman/podman.sock:/var/run/podman.sock --volume portainer_data:/data portainer/portainer-ce:lts
      # Si ya existía y lo que se quiere es actualizarlo:
        podman stop 10-portainer            # Detenerlo
        podman  rm  10-portainer            # Eiminarlo
        # Determinar el "image id" de la imagen base:
          podman image ls
        # Eliminar la imagen base para que descargue la mas reciente:
          podman image rm <ID determinado arriba>
    # Chequear que arrancó y está accesible en esos puertos:
      podman ps
    # Conectarse a http://<IP>:8000 o a https://<IP>:9443
    # NOTAS:
      # Para que mande al IP correcto desde los enlaces de cada container:
        Menu Environment-related > Environments > Local> Public IP field, IP del servidor > Update environment.
      # Para resetear el password:
        podman pull portainer/helper-reset-password
        podman run --rm -v portainer_data:/data portainer/helper-reset-password
      # Para resetear todo:
        podman stop 10-portainer            # Detenerlo
        podman volume rm portainer_data     # Eliminar sus datos
