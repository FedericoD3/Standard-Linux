# BRAVE
  # Con script de instalación
    curl -fsS https://dl.brave.com/install.sh | sh
  # "A pie"
    sudo curl -fsSLo /usr/share/keyrings/brave-browser-archive-keyring.gpg https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg    
    sudo curl -fsSLo /etc/apt/sources.list.d/brave-browser-release.sources https://brave-browser-apt-release.s3.brave.com/brave-browser.sources
    sudo apt update
    sudo apt install brave-origin   # Sin I.A., billetera, publicidad, rewards
    sudo apt install brave-browser  # Con I.A., billetera, publicidad, rewards

# CHROMIUM
  sudo apt install chromium

# UNGOOGLED CHROMIUM:
  # Con flatpak:
    flatpak install flathub io.github.ungoogled_software.ungoogled_chromium
    # y el launcher debe tener:
    flatpak run io.github.ungoogled_software.ungoogled_chromium
  # O instalación normal:
    wget -O UC.deb https://mxrepo.com/mx/repo/pool/main/u/ungoogled-chromium/ungoogled-chromium_149.0.7827.196-1mx25_amd64.deb
    sudo apt install ./UC.deb
    rm UC.deb

# THORIUM
  # Descargar el paquede DEB desde https://github.com/Alex313031/Thorium/releases
  #  Preferible AVX2
  #  Ver el CPU exacto con cat /proc/cpuinfo y googlear (AMD Ryzen 3 2200G soporta SSE4.2 y AVX2)
  #  Si aun no hay navegador instalado, descargarlo "a pie" desde el terminal:
    wget https://github.com/Alex313031/thorium/releases/download/M130.0.6723.174/thorium-browser_130.0.6723.174_AVX2.deb -O ~/thorium.deb
    sudo apt install ~/thorium.deb
    rm thorium.deb

# WATERFOX (Firefox pre-configurado, y le funcionan las extensiones en Android y Windows) 
  curl -fsSL https://download.opensuse.org/repositories/isv:/BrowserWorks/Debian_13/Release.key | gpg --dearmor | sudo tee /usr/share/keyrings/waterfox.gpg > /dev/null
  echo 'deb [signed-by=/usr/share/keyrings/waterfox.gpg] https://download.opensuse.org/repositories/isv:/BrowserWorks/Debian_13/ /' | sudo tee /etc/apt/sources.list.d/waterfox.list
  sudo apt update && sudo apt install waterfox
  # Si da problemas con dependencias, irse por la via de flatpack:
  flatpak install flathub net.waterfox.waterfox

# LIBREWOLF (Firefox pre-configurado rígido, y le funcionan las extensiones en Android y Windows) 
  sudo apt update
  sudo apt install extrepo -y
  sudo extrepo enable librewolf 
  sudo extrepo update librewolf
  sudo apt update 
  sudo apt install librewolf -y

