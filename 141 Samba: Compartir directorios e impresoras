# Instalar SAMBA, el compartidor de archivos en red:
  sudo apt install samba
# Instalar el cliente de texto de samba (util para verificar)
  sudo apt install smbclient
# Instalar el "Web Service Discovery Daemon", anunciador a la red de PCs Windows
  sudo apt install wsdd2 
  sudo systemctl enable wsdd2
  sudo systemctl start wsdd2
# Librerias de acceso a archivos en red:
  sudo apt install gvfs-backends

# TODO JUNTO:
  sudo apt install samba smbclient wsdd2 gvfs-backends

# Personalizar la configuración:
  sudo mv /etc/samba/smb.conf /etc/samba/smb.conf.ORIG
  sudo nano /etc/samba/smb.conf
# Con este contenido:
#####################################################################
#####################################################################

[global]
# Parametros de identificacion en la red :
  workgroup = RedFamiliar
  netbios name = NombreDelServidor
  server string = Servidor de archivos  
# Accesos desde la red:
  hosts allow = 127.0.0.1 AAA.BBB.CCC.0/24
  hosts deny = XXX.YYY.ZZZ.0/24
# Registro de actividad de cada cliente:
  log file = /var/log/samba/%M.log
  max log size = 1000
  logging = file
# Accion cuando Samba se congela, p.e. email al admin:
  panic action = /usr/share/samba/panic-action %d
# Authenticacion:
   server role = standalone server
   obey pam restrictions = yes
;   unix password sync = yes
;   passwd program = /usr/bin/passwd %u
;   passwd chat = *Enter\snew\s*\spassword:* %n\n *Retype\snew\s*\spassword:* %n\n *password\supdated\ssuccessfully* .
# This boolean controls whether PAM will be used for password changes
# when requested by an SMB client instead of the program listed in
# 'passwd program'. The default is 'no'.
   pam password change = yes
# Permitir conexiones anonimas (p.e. visitas):
   map to guest = bad user
############ Misc ############
  usershare allow guests = yes
#======================= Share Definitions =======================
#[homes]
#   comment = Home Directory of %U (%u)
#   browseable = no
#   read only = no
#   create mask = 0700
#   directory mask = 0700
#   valid users = %S
# Archivos con la configuracion de directorios compartidos comunes, individuales, departamental$
  include = /etc/samba/Includes/0-DirComunes.conf
  include = /etc/samba/Includes/%U.conf

#####################################################################
#####################################################################
# Ctrl+s para salvar, Ctrl+x para salir

# Configuracion por cada usuario:
  sudo nano /etc/samba/Includes/nombreusuarioconf
  # Misma sintaxis que "[homes]" arriba

# Agregar a Samba usuarios que ya existan en Linux:
  sudo smbpasswd -a AlgunUsuario
  sudo smbpasswd -a OtroUsuario

# Habilitar e iniciar los servicios:
  sudo systemctl enable  smbd
  sudo systemctl restart smbd
  sudo systemctl enable  wsdd2.service
  sudo systemctl restart wsdd2.service

# Listar usuarios ya en samba:
  sudo pdbedit -w -L
