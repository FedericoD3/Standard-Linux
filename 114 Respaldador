# REPLICADOR DE ARCHIVOS DE UN DIRECTORIO A OTRO 
# Instalar rsync
  sudo apt install rsync

# RESPALDAR A **OTRO** DISCO LOS ARCHIVOS MODIFICADOS DESDE EL ULTIMO RESPALDO:
#  (no tiene sentido respaldar al mismo disco)
# Respaldar y enviar el resultado del comando a un LOG cuyo nombre es la fecha en que se ejecuto
# -r recurse into directories
# -t preserve modification times
# -l copy symlinks as symlinks
# -H preserve hard links
# -i itemize changes (output a change-summary for all updates)
# -s no space-splitting; only wildcard special-chars

  rsync -r -t -l -H -i -s /Ruta/Al/Dir/Origen/ /Ruta/Al/Dir/Destino/ > /Ruta/Al/Registro/Respaldo_del_$(date +"%Y-%m-%d-%H%M").log

# Agregar el comando anterior al programador de tareas cron, a una hora que nadie este usando el computador

# Sincronizar desde servidor remoto:
  rsync --archive --verbose UsuarioRemoto@ServidorRemoto:/Directorio/Remoto/Fuente/ /Directorio/Local/Destino >> ${0##*/}.log
# Sincronizar hacia servidor remoto: 
  rsync --archive --verbose /Directorio/Local/Fuente/ UsuarioRemoto@ServidorRemoto:/Directorio/Remoto/Destino >> ${0##*/}.log
# Para que no pida la clave,
#  crear la private/public keys en el equipo local con (si no se ha creado antes):
   ssh-keygen
#  copiar la clave publica al equipo remoto:
   ssh-copy-id UsuarioRemoto@servidorRemoto
#  y asegurarse que el /home/UsuarioRemoto remoto tiene permisos 700
