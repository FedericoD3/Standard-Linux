# Crear un directorio para tener ahí los archivos relacionados:
  mkdir $HOME/go2rtc

# Descargar el 'latest release' de https://github.com/AlexxIT/go2rtc/
  curl -O $HOME/go2rtc https://github.com/AlexxIT/go2rtc/releases/download/v1.9.14/go2rtc_linux_amd64
# Hacerlo ejecutable:
  chmod +x $HOME/go2rtc

# Instalar Video For Linux para determinar fuentes locales de video:
  sudo apt install v4l-utils

  ll /dev/v4l/by-id
  ll /dev/v4l/by-path
  ll /dev/vid*
# Determinar controles de video0:
  sudo v4l2-ctl -d /dev/video0 --list-ctrls
# Ajustar un parametro de video0:
  sudo v4l2-ctl -c gain=255

# Crear una configuración vacia:
  touch $HOME/go2rtc/go2rtc_$(hostname).yml
# Ejecutar el streamer:
  $HOME/go2rtc/go2rtc --config $HOME/go2rtc/go2rtc_$(hostname).yml 

# Usar esta página para determinar las fuentes de video disponibles:
  http://localhos:1984/add.html
# Usar esta página para agregar las fuentes de video determinadas previamente:
  http://localhos:1984/config.html
  streams:
    Camara001:
      - StringDeterminadoEnAdd.Html
# Click en [Save & restart]
# Usar esta página para ver los streams en el navegador:
  http://localhos:1984/

# Después que funcione al gusto, terminar el proceso go2rtc, 
#  crear el .service en $HOME/.config/systemd/user/go2rtc.service
#  y activarlo con:
  systemctl --user daemon-reload
  systemctl --user enable --now go2rtc.service


